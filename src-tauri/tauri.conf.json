{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "番茄 AI 时钟",
  "version": "1.0.0",
  "identifier": "com.pomodoro.ai",
  "build": {
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "番茄 AI 时钟",
        "url": "http://localhost:3000",
        "width": 520,
        "height": 760,
        "minWidth": 440,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
